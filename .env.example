# URL pública do site (usada em canonical, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://fullgraph.com.br

# Número de WhatsApp comercial, somente dígitos, com DDI e DDD.
# Exemplo: 5561999999999
# IMPORTANTE: o site antigo não publicava esse número — confirme com a
# Fullgraph e preencha aqui. Sem ele, os CTAs de WhatsApp degradam para
# telefone fixo (61) 3022-0027 e e-mail.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Hero cinematográfico com scrub de vídeo (1 = ativo). O build de
# publicação usa 1; sem a flag, o site serve o hero clássico (cena 3D).
NEXT_PUBLIC_HERO_SCRUB=
